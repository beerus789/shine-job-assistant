# Copy to .env and fill these locally. Never commit .env.
SHINE_EMAIL=you@example.com
SHINE_PASSWORD=replace_me

# Safety defaults
DRY_RUN=true
HEADLESS=false
ENABLE_TRACING=false
MAX_APPLICATIONS_PER_RUN=20
MAX_APPLICATIONS_PER_DAY=20
MAX_APPLICATIONS_PER_ROLE_FAMILY=20
MAX_PAGES_PER_SEARCH=3
MAX_DETAIL_JOBS_PER_RUN=250
SEARCH_DELAY_MIN_SECONDS=2
SEARCH_DELAY_MAX_SECONDS=5
ACTION_DELAY_SECONDS=5

# Maximum time to wait for each website transition.
NAVIGATION_TIMEOUT_SECONDS=30
AUTH_TIMEOUT_SECONDS=15
APPLY_TIMEOUT_SECONDS=15
DETAIL_TIMEOUT_SECONDS=20
PER_JOB_TIMEOUT_SECONDS=45
MANUAL_RETRY_DELAY_HOURS=72
MAX_TRANSIENT_ATTEMPTS=2

# Truthful answers for supported card/dropdown fields.
# Salary values are in LPA (lakhs per annum); leave a value blank if unknown.
CANDIDATE_EXPERIENCE_YEARS=
CANDIDATE_EXPERIENCE_MONTHS=
CURRENT_SALARY_LPA=
EXPECTED_SALARY_LPA=
NOTICE_PERIOD_DAYS=
